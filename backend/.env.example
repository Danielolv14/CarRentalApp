# Copie para backend/.env e preencha. O .env não vai para o Git.
# Supabase > Project Settings > Database > Connection string > JDBC (use o "Session pooler", que funciona em IPv4)
DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.SEU_PROJECT_REF
DB_PASSWORD=SUA_SENHA_DO_BANCO

# update cria e ajusta as tabelas sozinho (bom para o laboratório)
JPA_DDL_AUTO=update

CORS_ALLOWED_ORIGINS=http://localhost:5173
