# Copie para backend/.env e preencha. O .env não vai para o Git.
# Supabase > Connect > Direct > Session pooler (funciona em IPv4). O host muda por projeto (aws-0, aws-1...).
DB_URL=jdbc:postgresql://aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.SEU_PROJECT_REF
DB_PASSWORD=SUA_SENHA_DO_BANCO

# update cria e ajusta as tabelas sozinho (bom para o laboratório)
JPA_DDL_AUTO=update

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Segredo que assina o token de login (mínimo de 32 caracteres). Gere um aleatório, por exemplo:
#   PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
#   Git Bash:   openssl rand -base64 48
JWT_SECRET=TROQUE_POR_UM_SEGREDO_ALEATORIO_COM_MAIS_DE_32_CARACTERES
JWT_VALIDADE_HORAS=8
