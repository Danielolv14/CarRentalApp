@startuml pacotes
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #3F4450
skinparam PackageBorderColor #15181E
skinparam PackageBackgroundColor #FFFFFF
skinparam DatabaseBorderColor #1F4FD8
skinparam DatabaseBackgroundColor #E8EEFC
skinparam NoteBackgroundColor #FFF6D6
skinparam NoteBorderColor #D9A300
skinparam TitleFontSize 18

title Diagrama de Pacotes (Visão Lógica) · Sistema de Aluguel de Carros (v1)
set separator none

package "Construção dinâmica das páginas web\n(front-end · React + Vite) <<subsistema>>" as FRONT #F5F4F0 {
  package pages {
    package publico
    package cliente
    package agente
  }
  package components
  package context
  package services
  package styles
}

package "Gestão de pedidos e contratos\n(back-end · Spring Boot, MVC) <<subsistema>>" as BACK #F3F6FE {
  package controller
  package dto
  package service
  package repository
  package model
  package security
  package config
  package exception
}

database "Supabase\n(PostgreSQL)" as DB

pages ..> components
pages ..> context
pages ..> services
components ..> styles
context ..> services

services ..> controller : HTTP / JSON (REST)

controller ..> dto
controller ..> service
security ..> repository
service ..> repository
service ..> model
service ..> dto
service ..> exception
repository ..> model
model ..> exception
repository ..> DB : JPA / JDBC

note as N1
  <b>MVC</b>
  M (model): entidades JPA, enums e regras do domínio
  C (controller): endpoints REST
  V (view): telas React do outro subsistema
end note
@enduml
